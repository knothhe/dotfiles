}

handle_batch_edit() {
    local entries=("$@")
    local total=${#entries[@]}
    local succeeded=0
    local failed=0
    local failed_entries=()
    local entry
    local index=0

    echo
    print_title "Batch Edit Password Entries"
    print_info "Selected entries" "$total"
    print_batch_entries "${entries[@]}"
    echo
    print_info "Edit behavior" "Entries will open one at a time in ${EDITOR:-vi}"

    if ! confirm_action "Edit these $total entries sequentially?" "n"; then
        print_warning "Batch edit cancelled"
        return 1
    fi

    for entry in "${entries[@]}"; do
        ((index++)) || true
        echo
        print_separator
        print_progress "Editing $index of $total: $entry"

        if pass edit "$entry"; then
            ((succeeded++)) || true
            print_success "Entry edited: $entry"
        else
            ((failed++)) || true
            failed_entries+=("$entry")
            print_error "Entry was not changed: $entry"
        fi
    done

    echo
    print_title "Batch Edit Summary"
    print_info "Result" "Succeeded: $succeeded | Failed or unchanged: $failed"

    if [ "$failed" -gt 0 ]; then
        print_warning "Entries not changed:"
        print_batch_entries "${failed_entries[@]}"
        return 1
    fi

    print_success_bold "All selected entries were edited successfully"
    return 0
}

handle_batch_password_generation() {
    local entries=("$@")
    local total=${#entries[@]}
    local default_length
    local length
    local include_symbols
    local symbols_label
    local succeeded=0
    local failed=0
    local failed_entries=()
    local entry
    local pass_args=()

    default_length=$(get_default_length)

    echo
    print_title "Batch Regenerate Passwords"
    print_info "Selected entries" "$total"
    print_batch_entries "${entries[@]}"
    echo
    echo -e "${GREEN}Use one password configuration for every selected entry:${NC}"
    echo
    echo -e "1) With symbols, $default_length chars ${YELLOW}[default]${NC}"
    echo -e "2) No symbols, $default_length chars"
    echo -e "3) Custom length with symbols"
    echo -e "4) Custom length without symbols"
    echo -e "5) ${RED}Cancel${NC}"
    echo

    while true; do
        echo -e "${BLUE}Select an option (1-5) [default: 1]:${NC}"
        read -r choice
        [ -z "$choice" ] && choice="1"

        case "$choice" in
            1)
                length="$default_length"
                include_symbols="true"
                break
                ;;
            2)
                length="$default_length"
                include_symbols="false"
                break
                ;;
            3)
                length=$(prompt_for_length "$default_length")
                include_symbols="true"
                break
                ;;
            4)
                length=$(prompt_for_length "$default_length")
                include_symbols="false"
                break
                ;;
            5)
                print_warning "Batch password regeneration cancelled"
                return 1
                ;;
            *)
                print_error "Invalid option. Please select 1-5"
                ;;
        esac
    done

    symbols_label="Yes"
    if [ "$include_symbols" = "false" ]; then
        symbols_label="No"
        pass_args+=(--no-symbols)
    fi
    pass_args+=(--in-place)

    echo
    print_separator
    print_info "Batch configuration" "Entries: $total | Length: $length | Symbols: $symbols_label"
    print_warning "This replaces only the first line of every selected entry. Additional attributes are preserved."
    print_warning "Batch changes are not atomic; successful entries remain changed if a later entry fails."
    echo

    if ! confirm_action "Regenerate passwords for all $total selected entries?" "n"; then
        print_warning "Batch password regeneration cancelled"
        return 1
    fi

    for entry in "${entries[@]}"; do
        print_progress "Regenerating password for: $entry"

        # Do not use --clip in batch mode. Multiple pass clipboard timers can
        # race with one another and leave an unexpected value in the clipboard.
        if pass generate "${pass_args[@]}" "$entry" "$length" >/dev/null 2>&1; then
            ((succeeded++)) || true
            print_success "Password regenerated: $entry"
        else
            ((failed++)) || true
            failed_entries+=("$entry")
            print_error "Failed to regenerate password: $entry"
        fi
    done

    echo
    print_title "Batch Regeneration Summary"
    print_info "Result" "Succeeded: $succeeded | Failed: $failed"
    print_info "Clipboard" "No generated passwords were copied"

    if [ "$failed" -gt 0 ]; then
        print_warning "Failed entries:"
        print_batch_entries "${failed_entries[@]}"
        return 1
    fi

    print_success_bold "All selected passwords were regenerated successfully"
    return 0
}

