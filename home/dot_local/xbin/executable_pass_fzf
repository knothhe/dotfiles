handle_view_all_attributes() {
    local entry="$1"

    echo
    print_title "View All Entry Attributes (Secure Mode)"

    # Get all entry content
    local entry_content
    entry_content=$(pass show "$entry" 2>/dev/null)

    if [ -z "$entry_content" ]; then
        print_error "Failed to retrieve entry content: $entry"
        return 1
    fi

    # Parse entry content
    local password
    local attributes=()
    local attr_names=()
    local attr_keys=()

    password=$(echo "$entry_content" | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    # Process additional lines as key-value pairs
    while IFS= read -r line; do
        if [ -n "$line" ] && [[ "$line" =~ ^[a-zA-Z0-9_-]+: ]]; then
            local key="${line%%:*}"
            local value="${line#*:}"
            # Trim whitespace from key and value
            key=$(trim_whitespace "$key")
            value=$(trim_whitespace "$value")
            # Reconstruct the trimmed line
            local trimmed_line="$key: $value"
            attributes+=("$trimmed_line")
            attr_keys+=("$key")
            attr_names+=("$key")
        elif [ -n "$line" ]; then
            # Handle lines without colon as additional info
            local trimmed_line=$(trim_whitespace "$line")
            local key="line_$((${#attributes[@]} + 1))"
            attributes+=("$trimmed_line")
            attr_keys+=("$key")
            attr_names+=("Additional Info")
        fi
    done < <(echo "$entry_content" | tail -n +2)

    # Display entry overview with all hidden values
    echo -e "${BLUE}┌${NC} ${BOLD}Entry Overview (Secure Mode)${NC}"
    echo -e "${BLUE}├${NC} Name: ${CYAN}$entry${NC}"
    echo -e "${BLUE}├${NC} Password: ${YELLOW}[HIDDEN]${NC} (${#password} characters)"
    echo -e "${BLUE}└${NC} Additional attributes: ${GREEN}${#attributes[@]}${NC} (all hidden)"
    echo

    # Display hidden attribute list
    if [ ${#attributes[@]} -gt 0 ]; then
        print_separator
        echo -e "${BLUE}🔒 ${BOLD}Hidden Attributes (Select to Reveal):${NC}"
        echo

        local i=1
        for key in "${attr_keys[@]}"; do
            if [[ "$key" =~ ^line_[0-9]+$ ]]; then
                echo -e "${CYAN}$i)${NC} ${YELLOW}[HIDDEN]${NC} Additional information"
            else
                echo -e "${CYAN}$i)${NC} ${BOLD}$key:${NC} ${YELLOW}[HIDDEN]${NC}"
            fi
            ((i++))
        done
        echo

        print_info "Security Notice" "All values are hidden. Select an option to reveal and copy."
        echo
    fi

    # Interactive menu for actions
    while true; do
        echo -e "${GREEN}What would you like to do?${NC}"
        echo -e "1) Reveal and copy password"
        [ ${#attributes[@]} -gt 0 ] && echo -e "2) Reveal and copy specific attribute"
        [ ${#attributes[@]} -gt 0 ] && echo -e "3) ${YELLOW}View all attributes${NC} (reveal & copy everything)"
        echo -e "4) Refresh view"
        echo -e "5) ${RED}Back to main menu${NC}"
        echo
        echo -e "${BLUE}Select an option (1-5):${NC}"
        read -r choice

        case "$choice" in
            1)
                # Reveal and copy password
                echo
                print_separator
                echo -e "${YELLOW}⚠${NC} ${BOLD}Password Reveal Confirmation${NC}"
                echo -e "${BLUE}Are you sure you want to reveal and copy the password?${NC}"
                echo -e "${BLUE}This will copy it to clipboard and display its length.${NC}"
                echo

                if confirm_action "Reveal and copy password?" "n"; then
                    if copy_sensitive_to_clipboard "$password"; then
                        echo
                        echo -e "${GREEN}✓${NC} ${BOLD}Password revealed and copied!${NC}"
                        echo -e "${BLUE}├${NC} Length: ${YELLOW}${#password} characters${NC}"
                        echo -e "${BLUE}└${NC} Auto-clear in ${YELLOW}${CLIPBOARD_CLEAR_TIME}s${NC}"
                        echo
                    else
                        print_error "Failed to copy password to clipboard"
                    fi
                else
                    print_warning "Password reveal cancelled"
                fi
                ;;
            2)
                # Reveal and copy specific attribute
                if [ ${#attributes[@]} -eq 0 ]; then
                    print_error "No attributes available to reveal"
                    continue
                fi

                echo
                echo -e "${BLUE}Select attribute to reveal and copy:${NC}"
                local i=1
                for key in "${attr_keys[@]}"; do
                    if [[ "$key" =~ ^line_[0-9]+$ ]]; then
                        echo -e "${CYAN}$i)${NC} Additional information"
                    else
                        echo -e "${CYAN}$i)${NC} $key"
                    fi
                    ((i++))
                done
                echo
                echo -e "${BLUE}Enter attribute number (1-${#attributes[@]}):${NC}"
                read -r attr_choice

                if [[ "$attr_choice" =~ ^[0-9]+$ ]] && [ "$attr_choice" -ge 1 ] && [ "$attr_choice" -le ${#attributes[@]} ]; then
                    local selected_attr="${attributes[$((attr_choice-1))]}"
                    local selected_key="${attr_keys[$((attr_choice-1))]}"
                    local copy_value
                    local display_name

                    if [[ "$selected_attr" =~ ^[a-zA-Z0-9_-]+: ]]; then
                        copy_value=$(trim_whitespace "${selected_attr#*:}")
                        display_name=$(trim_whitespace "${selected_attr%%:*}")
                    else
                        copy_value=$(trim_whitespace "$selected_attr")
                        display_name="Additional Information"
                    fi

                    echo
                    print_separator
                    echo -e "${YELLOW}⚠${NC} ${BOLD}Attribute Reveal Confirmation${NC}"
                    echo -e "${BLUE}Are you sure you want to reveal and copy:${NC} ${CYAN}$display_name${NC}"
                    echo

                    if confirm_action "Reveal and copy this attribute?" "n"; then
                        if copy_sensitive_to_clipboard "$copy_value"; then
                            echo
                            echo -e "${GREEN}✓${NC} ${BOLD}Attribute revealed and copied!${NC}"
                            echo -e "${BLUE}├${NC} ${BOLD}$display_name:${NC} ${YELLOW}$copy_value${NC}"
                            echo -e "${BLUE}└${NC} Auto-clear in ${YELLOW}${CLIPBOARD_CLEAR_TIME}s${NC}"
                            echo
                        else
                            print_error "Failed to copy attribute to clipboard"
                        fi
                    else
                        print_warning "Attribute reveal cancelled"
                    fi
                else
                    print_error "Invalid attribute number"
                fi
                ;;
            3)
                # Reveal and copy all attributes
                if [ ${#attributes[@]} -eq 0 ]; then
                    print_error "No additional attributes to reveal"
                    continue
                fi

                echo
                print_separator
                echo -e "${YELLOW}⚠${NC} ${BOLD}Full Reveal Confirmation${NC}"
                echo -e "${BLUE}Are you sure you want to reveal and copy ALL attributes?${NC}"
                echo -e "${BLUE}This includes: password + ${#attributes[@]} additional attributes${NC}"
                echo -e "${RED}This will expose all sensitive information!${NC}"
                echo

                if confirm_action "View all attributes? This will reveal and copy everything." "n"; then
                    # Build complete content string
                    local all_content="$password"
                    for attr in "${attributes[@]}"; do
                        all_content="$all_content"$'\n'"$attr"
                    done

                    if copy_sensitive_to_clipboard "$all_content"; then
                        echo
                        print_title "All Attributes Revealed"

                        # Display password
                        echo -e "${BLUE}┌${NC} ${BOLD}Password:${NC}"
                        echo -e "${BLUE}├${NC} Length: ${YELLOW}${#password} characters${NC}"
                        echo -e "${BLUE}└${NC} Value: ${GREEN}$password${NC}"
                        echo

                        # Display all attributes with their actual values
                        if [ ${#attributes[@]} -gt 0 ]; then
                            print_separator
                            echo -e "${BLUE}${BOLD}Additional Attributes:${NC}"
                            echo

                            local i=1
                            for attr in "${attributes[@]}"; do
                                local key="${attr_keys[$((i-1))]}"
                                local value

                                if [[ "$attr" =~ ^[a-zA-Z0-9_-]+: ]]; then
                                    value=$(trim_whitespace "${attr#*:}")
                                    display_key=$(trim_whitespace "${attr%%:*}")
                                else
                                    value=$(trim_whitespace "$attr")
                                    display_key="Additional Info"
                                fi

                                echo -e "${CYAN}$i) ${BOLD}$display_key:${NC}"
                                echo -e "${BLUE}└${NC} $value"
                                echo
                                ((i++))
                            done
                        fi

                        print_separator
                        echo -e "${GREEN}✓${NC} ${BOLD}All content copied to clipboard!${NC}"
                        echo -e "${BLUE}└${NC} Auto-clear in ${YELLOW}${CLIPBOARD_CLEAR_TIME}s${NC}"
                        echo
                        print_info "Summary" "Password + ${#attributes[@]} attributes"
                        echo
                    else
                        print_error "Failed to copy attributes to clipboard"
                    fi
                else
                    print_warning "View all attributes cancelled"
                fi
                ;;
            4)
                # Refresh view
                echo
                print_progress "Refreshing entry view"
                return 1  # Return to caller to reload
                ;;
            5)
                # Back to main menu
                return 0
                ;;
            *)
                print_error "Invalid option. Please select 1-5"
                ;;
        esac
    done
}

# ============================================================================
# MAIN FUNCTION
# ============================================================================

main() {
    check_script_dependencies

    # Validate password store directory
    if [ ! -d "$PASSWORD_STORE_DIR" ]; then
        print_error "Password store not found at: $PASSWORD_STORE_DIR"
        print_error "Please initialize pass with: pass init <gpg-id>"
        safe_exit 1
    fi

    print_title "Pass + Fzf Interactive Password Selection v$SCRIPT_VERSION"

    # Get password entries using optimized function
    local password_entries
    password_entries=$(get_password_entries)

    if [ -z "$password_entries" ]; then
        print_error "No password entries found in store"
        print_error "Add passwords with: pass insert <name>"
        safe_exit 1
    fi

    # Create secure temporary files and set up cleanup.
    local temp_file
    local entries_file
    local mode_file
    temp_file=$(create_temp_file "$TEMP_FILE_PREFIX")
    entries_file=$(create_temp_file "$TEMP_FILE_PREFIX")
    mode_file=$(create_temp_file "$TEMP_FILE_PREFIX")
    trap 'cleanup "$temp_file" "$entries_file" "$mode_file"' EXIT

    # Keep separate lists so the create marker can be hidden in multi-select mode.
    printf '%s\n' "$password_entries" > "$entries_file"
    {
        echo "$CREATE_NEW_ENTRY_MARKER"
        cat "$entries_file"
    } > "$temp_file"
    printf 'single\n' > "$mode_file"

    local single_prompt="[SINGLE] Select password entry: "
    local multi_prompt="[MULTI] Filter and mark entries: "
    local single_header="^T multi | ⏎ copy | ^E edit | ^G regenerate | ^R rename | ^D delete | ^V view"
    local multi_header="^T single | Tab mark | Shift-Tab unmark | ^A all matches | ^X clear | ⏎ actions | ^E edit | ^G regenerate"
    local toggle_mode_binding
    local select_all_binding
    local clear_selection_binding

    toggle_mode_binding="ctrl-t:transform:
        if [ \"\$FZF_PROMPT\" = \"$single_prompt\" ]; then
            printf '%s\\n' \"execute-silent(printf multi > '$mode_file')+change-multi+reload-sync(cat '$entries_file')+change-prompt($multi_prompt)+change-header($multi_header)\"
        else
            printf '%s\\n' \"execute-silent(printf single > '$mode_file')+clear-multi+change-multi(0)+reload-sync(cat '$temp_file')+change-prompt($single_prompt)+change-header($single_header)\"
        fi"

    # In multi mode, Ctrl-A means exactly "all current matches": discard any
    # hidden selections made under an earlier query before selecting matches.
    select_all_binding="ctrl-a:transform:
        if [ \"\$FZF_PROMPT\" = \"$multi_prompt\" ]; then
            printf '%s\\n' 'clear-multi+select-all'
        else
            printf '%s\\n' 'beginning-of-line'
        fi"

    clear_selection_binding="ctrl-x:transform:
        if [ \"\$FZF_PROMPT\" = \"$multi_prompt\" ]; then
            printf '%s\\n' 'clear-multi'
        else
            printf '%s\\n' 'ignore'
        fi"

    # Start in single-select mode. Ctrl-T changes the mode without leaving fzf
    # and preserves the current query while the input list is reloaded.
    local fzf_result
    local fzf_status=0
    fzf_result=$(cat "$temp_file" | fzf \
        --expect=enter,ctrl-e,ctrl-g,ctrl-r,ctrl-d,ctrl-v \
        --no-multi \
        --bind="$toggle_mode_binding" \
        --bind="$select_all_binding" \
        --bind="$clear_selection_binding" \
        --prompt="$single_prompt" \
        --height=80% \
        --layout=reverse \
        --border \
        --preview="if [ {} = '$CREATE_NEW_ENTRY_MARKER' ]; then echo 'Create a new password entry with custom name'; else echo 'Entry: {}'; fi" \
        --preview-window=down:1 \
        --header="$single_header") || fzf_status=$?

    if [ "$fzf_status" -eq 130 ]; then
        print_warning "Selection cancelled"
        return 0
    elif [ "$fzf_status" -ne 0 ]; then
        print_error "fzf exited with status $fzf_status"
        return "$fzf_status"
    fi

    # fzf prints the action key first, followed by every selected entry.
    # Use a read loop instead of mapfile for compatibility with macOS Bash 3.2.
    local key
    local output_line
    local output_line_number=0
    local selected_entries=()

    while IFS= read -r output_line; do
        if [ "$output_line_number" -eq 0 ]; then
            key="$output_line"
        elif [ -n "$output_line" ]; then
            selected_entries+=("$output_line")
        fi
        ((output_line_number++)) || true
    done <<< "$fzf_result"

    if [ ${#selected_entries[@]} -eq 0 ]; then
        print_warning "No selection made"
        return 0
    fi

    local selection_mode
    selection_mode=$(tr -d '\r\n' < "$mode_file")

    # The create marker is intentionally absent from multi mode. Handle it
    # before validating normal password entries.
    if [ "$selection_mode" = "single" ] && \
        [ ${#selected_entries[@]} -eq 1 ] && \
        [ "${selected_entries[0]}" = "$CREATE_NEW_ENTRY_MARKER" ]; then
        if [ "$key" = "enter" ]; then
            handle_new_entry "$CREATE_NEW_ENTRY_MARKER"
            return $?
        fi

        print_error "Only Enter can be used with new entry creation"
        print_info "Solution" "Press Enter to create a new password entry"
        return 1
    fi

    local entry
    for entry in "${selected_entries[@]}"; do
        if ! entry_exists "$entry"; then
            print_error "Password entry no longer exists: $entry"
            return 1
        fi
    done

    if [ "$selection_mode" = "multi" ]; then
        case "$key" in
            "enter")
                handle_batch_action_menu "${selected_entries[@]}"
                ;;
            "ctrl-e")
                handle_batch_edit "${selected_entries[@]}"
                ;;
            "ctrl-g")
                handle_batch_password_generation "${selected_entries[@]}"
                ;;
            "ctrl-r"|"ctrl-d"|"ctrl-v")
                print_warning "Rename, delete, and view are disabled in multi-select mode"
                print_info "Available batch actions" "Enter: action menu | Ctrl-E: edit | Ctrl-G: regenerate"
                return 0
                ;;
            *)
                print_warning "No batch action selected"
                return 0
                ;;
        esac
        return $?
    fi

    local selected_entry="${selected_entries[0]}"
    case "$key" in
        "enter")
            handle_existing_entry "$selected_entry" "copy"
            ;;
        "ctrl-e")
            handle_existing_entry "$selected_entry" "edit"
            ;;
        "ctrl-g")
            handle_existing_entry "$selected_entry" "generate"
            ;;
        "ctrl-r")
            handle_existing_entry "$selected_entry" "rename"
            ;;
        "ctrl-d")
            handle_existing_entry "$selected_entry" "delete"
            ;;
        "ctrl-v")
            handle_existing_entry "$selected_entry" "view"
            ;;
        *)
            print_warning "No action selected"
            return 0
            ;;
    esac
}

# Run main function
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
